{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{website,accounts,admin,assets,uploads,lib}/**/*"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
